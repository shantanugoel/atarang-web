{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atarang.local/schemas/backup-manifest-v1.json",
  "title": "BackupManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backupId", "createdAt", "includeMedia", "records", "assets"],
  "properties": {
    "schema": {"const": "atarang.backup/1"},
    "backupId": {"type": "string", "format": "uuid"},
    "createdAt": {"type": "string", "format": "date-time"},
    "includeMedia": {"type": "boolean"},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originals", "separations", "performances", "practice", "lyrics", "charts", "beats"],
      "properties": {
        "originals": {"type": "array", "items": {"type": "object"}},
        "separations": {"type": "array", "items": {"type": "object"}},
        "performances": {"type": "array", "items": {"type": "object"}},
        "practice": {"type": "array", "items": {"type": "object"}},
        "lyrics": {"type": "array", "items": {"type": "object"}},
        "charts": {"type": "array", "items": {"type": "object"}},
        "beats": {"type": "array", "items": {"type": "object"}}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryName", "blobId", "sha256", "byteLength", "mediaType"],
        "properties": {
          "entryName": {"type": "string", "pattern": "^assets/[0-9a-f]{64}$"},
          "blobId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byteLength": {"type": "integer", "minimum": 1},
          "mediaType": {"type": "string"}
        }
      }
    }
  }
}
