{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://atarang.local/schemas/model-artifact-manifest-v1.json",
  "title":"ModelArtifactManifestV1",
  "type":"object",
  "required":["schema","modelArtifactId","modelId","artifactVersion","artifactSha256","ortVersion","totalBytes","pieces","graphs","upstream","license","createdAt"],
  "properties":{
    "schema":{"const":"atarang.model/1"},
    "modelArtifactId":{"type":"string","format":"uuid"},
    "modelId":{"const":"htdemucs-web-onnx"},
    "artifactVersion":{"type":"string","minLength":1},
    "artifactSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ortVersion":{"const":"1.27.0"},
    "totalBytes":{"type":"integer","minimum":1},
    "pieces":{"type":"array","minItems":21,"maxItems":21,"items":{"type":"object","required":["name","url","order","byteLength","sha256","inputs","outputs"],"properties":{"name":{"type":"string","minLength":1},"url":{"type":"string","pattern":"^/models/"},"order":{"type":"integer","minimum":0,"maximum":20},"byteLength":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"inputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"outputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}},"additionalProperties":false}},
    "graphs":{"type":"object","required":["inputs","outputs","stftOutsideGraph"],"properties":{"inputs":{"const":["mix","mag"]},"outputs":{"type":"object","required":["freq","time"],"properties":{"freq":{"type":"string","minLength":1},"time":{"type":"string","minLength":1}},"additionalProperties":false},"stftOutsideGraph":{"const":true}},"additionalProperties":false},
    "upstream":{"const":"monteslu/htdemucs-web-onnx"},
    "license":{"const":"MIT"},
    "createdAt":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
