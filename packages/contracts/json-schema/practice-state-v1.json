{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atarang.local/schemas/practice-state-v1.json",
  "title": "PracticeStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "originalId", "revision", "sourceTimeUs", "target", "loop", "speed", "pitchSemitones", "repetitions", "pauseSeconds", "countIn", "metronome", "stemGainDb", "updatedAt"],
  "properties": {
    "schema": { "const": "atarang.practice/1" },
    "originalId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "sourceTimeUs": { "type": "integer", "minimum": 0 },
    "target": { "enum": ["vocals", "drums", "bass", "other"] },
    "loop": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "startTimeUs", "endTimeUs"],
      "properties": { "enabled": {"type":"boolean"}, "startTimeUs": {"type":"integer","minimum":0}, "endTimeUs": {"type":"integer","minimum":500000} }
    },
    "speed": { "type": "number", "minimum": 0.5, "maximum": 1 },
    "pitchSemitones": { "type": "integer", "minimum": -12, "maximum": 12 },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 999 },
    "pauseSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
    "countIn": { "enum": [0, 2, 4] },
    "metronome": { "type": "boolean" },
    "stemGainDb": {
      "type": "object", "additionalProperties": false,
      "required": ["vocals", "drums", "bass", "other"],
      "properties": { "vocals": {"type":"number"}, "drums": {"type":"number"}, "bass": {"type":"number"}, "other": {"type":"number"} }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "startTimeUs", "endTimeUs"],
        "properties": { "id": {"type":"string","minLength":1}, "name": {"type":"string","minLength":1}, "startTimeUs": {"type":"integer","minimum":0}, "endTimeUs": {"type":"integer","minimum":500000} }
      }
    },
    "speedRampPercent": { "type": "number", "minimum": 0, "maximum": 25 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
