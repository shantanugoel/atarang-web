{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://atarang.local/schemas/separation-manifest-v1.json",
  "title":"SeparationManifestV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","separationId","original","model","pipeline","stems","provenance"],
  "properties":{
    "schema":{"const":"atarang.separation/1"},
    "separationId":{"type":"string","format":"uuid"},
    "original":{"type":"object","additionalProperties":false,"required":["originalId","contentSha256","sourceMediaType","sampleRate","channels","durationFrames"],"properties":{"originalId":{"type":"string","format":"uuid"},"contentSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sourceMediaType":{"type":"string"},"sampleRate":{"type":"integer","minimum":1},"channels":{"enum":[1,2]},"durationFrames":{"type":"integer","minimum":1}}},
    "model":{"type":"object","additionalProperties":false,"required":["modelId","artifactVersion","artifactSha256","upstream","license"],"properties":{"modelId":{"const":"htdemucs-4stem"},"artifactVersion":{"type":"string"},"artifactSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"upstream":{"const":"facebookresearch/demucs htdemucs"},"license":{"const":"MIT"}}},
    "pipeline":{"type":"object","additionalProperties":false,"required":["implementation","implementationVersion","decodeVersion","preprocessVersion","segmentFrames","overlapFrames","shifts","postprocessVersion"],"properties":{"implementation":{"enum":["browser-ort-web","server-pytorch"]},"implementationVersion":{"type":"string"},"decodeVersion":{"type":"string"},"preprocessVersion":{"type":"string"},"segmentFrames":{"type":"integer","minimum":1},"overlapFrames":{"type":"integer","minimum":0},"shifts":{"type":"integer","minimum":1},"postprocessVersion":{"type":"string"}}},
    "stems":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"$ref":"#/$defs/vocals"},{"$ref":"#/$defs/drums"},{"$ref":"#/$defs/bass"},{"$ref":"#/$defs/other"}]},
    "provenance":{"type":"object","additionalProperties":false,"required":["mode","createdAt"],"properties":{"mode":{"enum":["local","cloud"]},"createdAt":{"type":"string","format":"date-time"}}}
  },
  "$defs":{
    "variant":{"type":"object","additionalProperties":false,"required":["encoding","mediaType","byteLength","sha256"],"properties":{"encoding":{"enum":["flac","pcm-f32le-wav"]},"mediaType":{"type":"string"},"byteLength":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "stemBase":{"type":"object","additionalProperties":false,"required":["kind","blobId","sampleRate","channels","durationFrames","variants"],"properties":{"kind":{"type":"string"},"blobId":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"sampleRate":{"type":"integer","minimum":1},"channels":{"const":2},"durationFrames":{"type":"integer","minimum":1},"variants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/variant"}}}},
    "vocals":{"allOf":[{"$ref":"#/$defs/stemBase"},{"properties":{"kind":{"const":"vocals"}}}]},
    "drums":{"allOf":[{"$ref":"#/$defs/stemBase"},{"properties":{"kind":{"const":"drums"}}}]},
    "bass":{"allOf":[{"$ref":"#/$defs/stemBase"},{"properties":{"kind":{"const":"bass"}}}]},
    "other":{"allOf":[{"$ref":"#/$defs/stemBase"},{"properties":{"kind":{"const":"other"}}}]}
  }
}
